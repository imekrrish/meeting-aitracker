{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Backend: Dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:backend"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Frontend: Dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:frontend"
            ],
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Fullstack: Dev",
            "configurations": [
                "Backend: Dev",
                "Frontend: Dev"
            ]
        }
    ]
}